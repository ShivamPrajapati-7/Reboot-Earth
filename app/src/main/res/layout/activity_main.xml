<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EcoVision"
            android:textColor="#245B35"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Smart waste identification"
            android:textColor="#647067"
            android:textSize="16sp" />

        <!-- Image selection section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Scan your waste"
            android:textColor="#1D3022"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select a clear photo of one waste item."
            android:textColor="#647067"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="20dp"
            android:background="#E2E9DE"
            android:contentDescription="Selected waste photo"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Take Photo"
            android:textColor="@android:color/white"
            android:backgroundTint="#245B35" />


        <!-- Choose image button -->
        <Button
            android:id="@+id/btnChooseImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/choose_image_btn"
            android:text="Choose Image"
            android:textColor="@color/green"
            app:backgroundTint="@null" />

        <!-- Identify waste button -->
        <Button
            android:id="@+id/btnClassify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#245B35"
            android:enabled="false"
            android:text="Identify Waste"
            android:textColor="@android:color/white" />

        <!-- Classification result -->
        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Classification result will appear here."
            android:textColor="#245B35"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Confidence score -->
        <TextView
            android:id="@+id/txtConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#647067"
            android:textSize="14sp" />

        <!-- Disposal guidance and low-confidence warning -->
        <TextView
            android:id="@+id/txtGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E2E9DE"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="Disposal guidance will appear here."
            android:textColor="#263C2B"
            android:textSize="16sp"
            android:textIsSelectable="true" />

        <!-- Recycling disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="8dp"
            android:text="Note: Disposal recommendations depend on local recycling rules. Verify uncertain predictions before disposing of waste."
            android:textColor="#647067"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
